{
  "name": "forja",
  "description": "Forja: open source, self-hosted Lovable alternative. Prompt → full-stack Next.js app with hosting, database, auth, visual editor, GitHub sync and custom domains. MIT.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @forja/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start -w @forja/web"
  },
  "devDependencies": {
    "@types/node": "24.0.4",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "vitest": "^4.1.11",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "dompurify": "^3.4.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/charcsllc/forja.git"
  },
  "homepage": "https://github.com/charcsllc/forja#readme",
  "license": "MIT",
  "author": "Totalum Labs",
  "bugs": {
    "url": "https://github.com/charcsllc/forja/issues"
  },
  "keywords": [
    "forja",
    "lovable-alternative",
    "open-source-lovable",
    "lovable",
    "ai-app-builder",
    "vibe-coding",
    "self-hosted",
    "nextjs",
    "prompt-to-app",
    "no-code",
    "totalum"
  ]
}
