# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string (compose.yaml overrides it with the `db` service).
DATABASE_URL=postgres://app:app@localhost:5432/app
# 32+ random characters: `openssl rand -base64 32`. Keep it secret; rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Public URL of the app, as the browser sees it (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Origins (optional) ──────────────────────────────────────────────────────
# URL the app is reachable at from inside its own network (container name), trusted by auth.
INTERNAL_APP_URL=
# Space- or comma-separated origins allowed to frame the app (CSP frame-ancestors). Empty = 'self'.
ALLOWED_FRAME_ANCESTORS=
# Extra origins trusted by auth (space- or comma-separated).
EXTRA_TRUSTED_ORIGINS=

# ── Logging (optional) ──────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Email (optional; without SMTP_HOST mail is printed to the log) ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS (port 465); STARTTLS is negotiated automatically otherwise.
SMTP_SECURE=false
SMTP_FROM=App <no-reply@localhost>

# ── File storage (optional; without S3_BUCKET files are stored on local disk) ─
# Local folder for uploads. Default: .data/uploads (development), /data/uploads (production).
STORAGE_DIR=
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO…).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket or CDN; empty = files are served by /api/files/<name>.
S3_PUBLIC_URL=
# true for MinIO and other path-style endpoints.
S3_FORCE_PATH_STYLE=false

# ── Background jobs (optional) ──────────────────────────────────────────────
# inline = run registered job handlers inside the web process; off = do not run them here.
JOBS_MODE=inline

# ── Tests (optional) ────────────────────────────────────────────────────────
# A Postgres URL the integration tests may use (they create and drop their own databases).
DATABASE_URL_TEST=

# ── Tooling ─────────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
