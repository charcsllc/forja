# Copy to .env.production and fill in. Used by compose.prod.yaml (`migrate`, `app` and `db`).
# Never commit the filled-in file.

# Postgres password for the bundled `db` service. Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@db:5432/app

# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The public URL, e.g. https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
INTERNAL_APP_URL=
EXTRA_TRUSTED_ORIGINS=
LOG_LEVEL=info

# Email: set SMTP_* to deliver mail (otherwise it is only logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=App <no-reply@example.com>

# Storage: local volume (/data/uploads) unless S3_BUCKET is set.
STORAGE_DIR=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

JOBS_MODE=inline
