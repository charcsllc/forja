{
  "name": "@forja/agents",
  "version": "0.0.0",
  "private": true,
  "description": "Forja's agent team: role definitions, the canonical tool registry, the uniform agent loop over @forja/llm, the prompt assembler (prompts bundled from docs/prompts at build time) and the agents:eval harness.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./eval": { "types": "./src/eval/index.ts", "default": "./src/eval/index.ts" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "eval": "tsx src/eval/cli.ts",
    "prompts:bundle": "node scripts/bundle-prompts.mjs",
    "prompts:check": "node scripts/bundle-prompts.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@forja/contracts": "0.0.0",
    "@forja/llm": "0.0.0",
    "zod": "^3.25.76"
  }
}
