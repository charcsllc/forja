{
  "name": "@forja/llm",
  "version": "0.0.0",
  "private": true,
  "description": "The only door to language models in Forja: provider env parsing, the provider catalog, the openai-compatible adapter, the gateway (router, rate limiter, budget) and (for tests) a record/replay provider.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./env": { "types": "./src/env.ts", "default": "./src/env.ts" },
    "./types": { "types": "./src/types.ts", "default": "./src/types.ts" },
    "./errors": { "types": "./src/errors.ts", "default": "./src/errors.ts" },
    "./catalog": { "types": "./src/catalog/index.ts", "default": "./src/catalog/index.ts" },
    "./adapters": { "types": "./src/adapters/index.ts", "default": "./src/adapters/index.ts" },
    "./gateway": { "types": "./src/gateway/index.ts", "default": "./src/gateway/index.ts" },
    "./replay": { "types": "./src/replay/index.ts", "default": "./src/replay/index.ts" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "llm:smoke": "tsx src/cli/smoke.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
