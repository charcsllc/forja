# ---------------------------------------------------------------------------
# Required (Node 20+, see .nvmrc)
# ---------------------------------------------------------------------------
# Your Totalum API key. This is the ONLY variable that must be set for the app
# to work. Register on https://www.totalum.app/api and, during onboarding, choose
# "Use the Totalum API" to get your key.
# API reference: https://www.totalum.app/totalum-api.md
TOTALUM_VCAAS_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public base URL of this app. Used by src/proxy.ts to allow-list the origin
# for CSP/CORS in production. Defaults to same-host if unset, so you usually
# only need this for a custom production domain.
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Next.js telemetry is already disabled in next.config.ts; this repeats it for tools that
# read .env files. `npx next telemetry disable` also turns it off machine-wide.
NEXT_TELEMETRY_DISABLED=1
