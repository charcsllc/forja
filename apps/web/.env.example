# ---------------------------------------------------------------------------
# Backend (Node 20+, see .nvmrc). Pick ONE of the two options below.
# ---------------------------------------------------------------------------
# Option A: the self-hosted Forja Engine (apps/engine). When FORJA_ENGINE_URL is
# set, every call goes to the engine and the Totalum variables are ignored.
# Server-side only: the browser never talks to the engine directly.
# FORJA_ENGINE_URL=http://engine:4000
#
# The engine's API key. Either set it here, or leave it empty and point
# FORJA_ENGINE_KEY_FILE at the file the compose `init` service writes
# (default /data/engine/engine.key, mounted read-only into the web container).
# FORJA_ENGINE_KEY=
# FORJA_ENGINE_KEY_FILE=/data/engine/engine.key

# Option B: Totalum (used when FORJA_ENGINE_URL is unset). Register on
# https://www.totalum.app/api and, during onboarding, choose "Use the Totalum
# API" to get your key. API reference: https://www.totalum.app/totalum-api.md
TOTALUM_VCAAS_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public base URL of this app. Used by src/proxy.ts to allow-list the origin
# for CSP/CORS in production, and (engine mode) to recognise this app's own
# /api/files/<token> URLs. Defaults to same-host if unset, so you usually
# only need this for a custom production domain.
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Next.js telemetry is already disabled in next.config.ts; this repeats it for tools that
# read .env files. `npx next telemetry disable` also turns it off machine-wide.
NEXT_TELEMETRY_DISABLED=1
