# Forja Engine environment (docs/architecture/09-env-reference.md).
# Every value below is the documented default; an empty value means "use the default".
# Local dev: cp .env.example .env && npm run dev -w @forja/engine   (tsx --env-file=.env)
# In compose these come from infra/.env; see infra/README.md.
#
# LLM_*, IMAGE_*, STOCK_* and AGENT_* settings: see below and docs/architecture/09-env-reference.md.
# The engine already collects them raw (config.rawProviderEnv) and ignores them.

# ───────────── Proveedores LLM · "<activo>|<api_key>" (09-env-reference.md, 02 §1) ─────────────
# Siempre entre comillas. Ejemplo activo: LLM_NVIDIA="true|nvapi-…". Nunca subas una clave real.
# Adaptador listo: nvidia zai qwen deepseek moonshot minimax mistral groq together fireworks openrouter
# ollama lmstudio vllm. Pendientes (se saltan con un aviso): anthropic openai google xai.
LLM_ANTHROPIC="false|"
LLM_OPENAI="false|"
LLM_GOOGLE="false|"
LLM_ZAI="false|"                 # China: LLM_ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_QWEN="false|"                # LLM_QWEN_BASE_URL=https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_DEEPSEEK="false|"
LLM_MOONSHOT="false|"
LLM_MINIMAX="false|"
LLM_MISTRAL="false|"
LLM_XAI="false|"
LLM_GROQ="false|"
LLM_TOGETHER="false|"
LLM_FIREWORKS="false|"
LLM_OPENROUTER="false|"
LLM_NVIDIA="false|"              # NVIDIA NIM (build.nvidia.com); nivel gratuito ≈ 40 peticiones/min
# LLM_NVIDIA_RPM=40              # defecto; LLM_NVIDIA_TIMEOUT_MS=300000 (espera hasta el primer byte)
LLM_OLLAMA="false|"              # local; clave opcional
# LLM_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LLM_LMSTUDIO="false|"
LLM_VLLM="false|"                # requiere LLM_VLLM_BASE_URL
# Opcionales por proveedor: LLM_<P>_BASE_URL, LLM_<P>_ORG, LLM_<P>_TIMEOUT_MS, LLM_<P>_MAX_CONCURRENCY,
# LLM_<P>_RPM, LLM_<P>_EXTRA_MODELS='[{"id":"…","contextTokens":…,"maxOutputTokens":…,"nativeTools":true}]'
# Forma separada (si ambas existen y discrepan, error de arranque): LLM_<P>_ENABLED, LLM_<P>_API_KEY
# Prueba manual (UNA petición real): npm run llm:smoke -- --provider nvidia --tools --env-file infra/.env --yes-spend-one-request

# Presupuestos (USD; vacío = sin límite; 02 §6)
BUDGET_PER_RUN_USD=8
BUDGET_PER_PROJECT_MONTH_USD=60
BUDGET_GLOBAL_MONTH_USD=

# Orquestación (03 §6)
ENGINE_MAX_CONCURRENT_RUNS=2
RUN_REQUIRE_PLAN_APPROVAL=false
RUN_ALLOW_QUESTIONS=false

# ───────────── Imágenes (02 §7) ─────────────
# true → nunca usar un modelo de generación de imágenes: buscar fotos con licencia abierta en la
# web (STOCK_* activos, luego Openverse y Wikimedia Commons, sin clave). El modal Settings de la UI
# puede sobrescribirlo y gana hasta "Reset to .env". Acepta true/false/1/0/yes/no/on/off.
IMAGES_FROM_WEB_SEARCH=false

# ───────────── Engine ─────────────
FORJA_ENGINE_KEY=                # servidor: obligatorio; local: lo genera el servicio init en /data/engine/engine.key
FORJA_MASTER_KEY=                # 32 bytes base64; servidor: obligatorio; local: init → /data/engine/master.key
DATABASE_URL=postgres://forja:forja@postgres:5432/forja
DATA_DIR=/data                   # dentro del engine
DATA_DIR_HOST=/srv/forja/data    # la MISMA carpeta vista por el daemon Docker (bind mounts); comprobado al arrancar
ENGINE_PORT=4000
ENGINE_INSTANCES=1               # >1 requiere REDIS_URL para el pub/sub de deltas
LOG_LEVEL=info
LOGS_RETENTION_DAYS=7
EVENTS_RETENTION_DAYS=30
UPLOAD_MAX_MB=8
# Docker API for the health probe (and dockerode from phase 1). Compose sets tcp://socket-proxy:2375.
# Empty = docker "unavailable" in /v2/system/health.
DOCKER_HOST=

# Sandboxes (04)
SANDBOX_DRIVER=docker            # docker | process (solo desarrollo de Forja)
SANDBOX_RUNTIME=                 # vacío = runc; runsc = gVisor
SANDBOX_MEM=2g
SANDBOX_CPUS=2
SANDBOX_PIDS=512
SANDBOX_EGRESS=internet          # internet | registry-only
SANDBOX_IDLE_MINUTES=120
SANDBOX_MAX_ACTIVE=5
SANDBOX_START_TIMEOUT_SEC=300
DISK_MIN_FREE_GB=5
PROJECT_MAX_SIZE_MB=2048
PROJECT_PURGE_AFTER_DAYS=7
TEMPLATE_DIR=/opt/forja/templates/nextjs-postgres   # plantilla copiada a cada proyecto nuevo (la imagen del engine la incluye)
RUNNER_IMAGE=forja-runner:1.0.0  # imagen de forja-app-<id> (infra/images/runner), etiquetada con la versión de la plantilla
SANDBOX_DB_IMAGE=postgres:17-alpine
ENGINE_CONTAINER=                # contenedor del engine que se une a forja-int-<id> (CMS); vacío = hostname (id corto)

# Preview y publicación (04 §4, §7)
PREVIEW_DOMAIN=forja.localhost
PREVIEW_TLS=false
PREVIEW_PUBLIC=true              # local. En modo servidor (PUBLISH_TLS=true) el valor por defecto es false
PUBLISH_DOMAIN=apps.forja.localhost
PUBLISH_TLS=false
PUBLISH_IP=                      # registros A para dominios personalizados
ACME_EMAIL=                      # obligatorio con *_TLS=true
ACME_DNS_PROVIDER=               # p. ej. cloudflare, route53, digitalocean (comodín por DNS-01); vacío = HTTP-01 por host
# ACME_DNS_<PROVIDER>_*=         # credenciales según el proveedor (documentación de Traefik)
TRAEFIK_DASHBOARD=false
WEB_PUBLIC_URL=http://localhost:3000   # origen público de la UI: URLs firmadas ${WEB_PUBLIC_URL}/api/files/<token>

# Varios
ALLOW_ENV_EXPORT=false
NPM_ALLOWLIST_FILE=
BACKUP_DIR=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
WEBHOOK_TIMEOUT_MS=10000
