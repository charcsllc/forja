# infra/.env: variables for docker compose (interpolation) and the engine (env_file).
#   cp infra/.env.example infra/.env
#   docker compose -f infra/compose.yaml --env-file infra/.env up -d
# Engine settings (budgets, sandbox limits, LLM_* providers from phase 2...) can be added
# here too: see apps/engine/.env.example and docs/architecture/09-env-reference.md.
# web never receives this file; it gets only the variables listed in compose.yaml.

# Host folder for projects, uploads, keys and Traefik's dynamic config. Must be the SAME
# path the Docker daemon sees (the engine bind-mounts subfolders into sandboxes).
# Docker Desktop: a folder under a shared path, e.g. /Users/<you>/forja-data.
DATA_DIR_HOST=/srv/forja/data

# Preview: http://<id>.forja.localhost · Publish: http://<id>.apps.forja.localhost
PREVIEW_DOMAIN=forja.localhost
PUBLISH_DOMAIN=apps.forja.localhost

# Engine database password (postgres is only on forja-core; never published).
# Generate one: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# Empty = the engine publishes no port. To expose it, set a host binding and add
# -f infra/compose.expose.yaml to the command, e.g. ENGINE_EXPOSE=127.0.0.1:4000
ENGINE_EXPOSE=

# Optional bindings (defaults shown). Server: TRAEFIK_BIND_IP=0.0.0.0 and put web behind Traefik.
# WEB_BIND=127.0.0.1:3000
# WEB_PUBLIC_URL=http://localhost:3000
# TRAEFIK_BIND_IP=127.0.0.1
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_HTTPS_PORT=443

# Sandbox image every project runs in (phase 1). Build it once from the repo root:
#   docker build -t forja-runner:1.0.0 -f infra/images/runner/Dockerfile .
# RUNNER_IMAGE=forja-runner:1.0.0

# With the engine running (phase 1) the UI talks to it; this key is only a fallback when
# FORJA_ENGINE_URL is unset (it is always set in compose).
# TOTALUM_VCAAS_API_KEY=

# ───────────── Proveedores LLM · "<activo>|<api_key>" (09-env-reference.md, 02 §1) ─────────────
# Siempre entre comillas. Ejemplo activo: LLM_NVIDIA="true|nvapi-…". Nunca subas una clave real.
# Adaptador listo: nvidia zai qwen deepseek moonshot minimax mistral groq together fireworks openrouter
# ollama lmstudio vllm. Pendientes (se saltan con un aviso): anthropic openai google xai.
LLM_ANTHROPIC="false|"
LLM_OPENAI="false|"
LLM_GOOGLE="false|"
LLM_ZAI="false|"                 # China: LLM_ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_QWEN="false|"                # LLM_QWEN_BASE_URL=https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_DEEPSEEK="false|"
LLM_MOONSHOT="false|"
LLM_MINIMAX="false|"
LLM_MISTRAL="false|"
LLM_XAI="false|"
LLM_GROQ="false|"
LLM_TOGETHER="false|"
LLM_FIREWORKS="false|"
LLM_OPENROUTER="false|"
LLM_NVIDIA="false|"              # NVIDIA NIM (build.nvidia.com); nivel gratuito ≈ 40 peticiones/min
# LLM_NVIDIA_RPM=40              # defecto; LLM_NVIDIA_TIMEOUT_MS=300000 (espera hasta el primer byte)
LLM_OLLAMA="false|"              # local; clave opcional
# LLM_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LLM_LMSTUDIO="false|"
LLM_VLLM="false|"                # requiere LLM_VLLM_BASE_URL
# Opcionales por proveedor: LLM_<P>_BASE_URL, LLM_<P>_ORG, LLM_<P>_TIMEOUT_MS, LLM_<P>_MAX_CONCURRENCY,
# LLM_<P>_RPM, LLM_<P>_EXTRA_MODELS='[{"id":"…","contextTokens":…,"maxOutputTokens":…,"nativeTools":true}]'
# Forma separada (si ambas existen y discrepan, error de arranque): LLM_<P>_ENABLED, LLM_<P>_API_KEY
# Prueba manual (UNA petición real): npm run llm:smoke -- --provider nvidia --tools --env-file infra/.env --yes-spend-one-request

# ───────────── Imágenes (02 §7) ─────────────
# true → nunca usar un modelo de generación de imágenes: buscar fotos con licencia abierta en la
# web (STOCK_* activos, luego Openverse y Wikimedia Commons, sin clave). El modal Settings de la UI
# puede sobrescribirlo y gana hasta "Reset to .env". Acepta true/false/1/0/yes/no/on/off.
IMAGES_FROM_WEB_SEARCH=false
